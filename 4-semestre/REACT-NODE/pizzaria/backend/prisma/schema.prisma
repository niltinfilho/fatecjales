// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client" //Define o tipo de client gerado
  output   = "../src/generated/prisma" //caminho onde o cliente será criado no projeto
}

datasource db {
  provider = "postgresql" //Define que o banco utilizado é o postgresql
}

// Define um ENUM (valores fixos) para o tipo de usuário
enum Role {
  STAFF //usuário comum
  ADMIN //usuário adm
}

// Modelo de usuario (tabela "users" no banco)
model User {
  id String @id @default(uuid()) //ID unico gerado automaticamente (UUID)
  name String //nome do usuário
  email String @unique //email único
  password String //Senha do usuário
  role Role @default(STAFF) //papel de um usuário (padrão: STAFF)
  createdAt DateTime @default(now()) //Data de criação
  updated DateTime @updatedAt // Atualiza automaticamente ao modificar o registro
  
  @@map("users")// Nome da tabela no banco de dados
}

// Modelo de categorias de produtos
model Category {
  id String @id @default(uuid()) //ID unico
  name String //nome da categoria
  createdAt DateTime @default(now()) //Data de criação
  updated DateTime @updatedAt // Atualiza automaticamente ao modificar o registro

  products Product[] //Relação: uma categoria pode ter vários produtos
  
  @@map("categories") //nome da tabela no banco de dados
}

// Modelo de produtos 
model Product {
  id String @id @default(uuid()) //ID unico
  name String //nome do produto
  price Int //preço do produto em centavos ex: 1000 = R$10,00
  description String //descrição do produto
  banner String //URL ou caminho da imagem do produto
  disabled Boolean @default(false) //Indica se o produto está desativado

  items Item[] //Relação com itens de pedidos

  category_id String //chave estrangeira da categoria
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade) //relação: um produto pertence a uma categoria e o onDelete: cascade - se a categoria for deletada, os produtos também serão

  createdAt DateTime @default(now()) //Data de criação
  updated DateTime @updatedAt // Atualiza automaticamente ao modificar o registro
  
  @@map("products") //nome da tabela no banco de dados
}

model Order {
  id String @id @default(uuid()) //ID unico
  table Int //número da mesa

  status Boolean @default(false) //status do pedido (false = pendente, true = pronto)
  
  draft Boolean @default(true) //Indica se ainda é um rascunho (true = ainda não enviado, false = enviado par aa cozinha)
  
  name String? // Nome do cliente (opcional)

  items Item[] //Relação: um pedido pode ter vários itens
  
  createdAt DateTime @default(now()) //Data de criação
  updated DateTime @updatedAt // Atualiza automaticamente ao modificar o registro

  @@map("orders") //nome da tabela no banco de dados
}

model Item {
  id String @id @default(uuid()) //ID unico
  amount Int // Quantidade do produto pedido

  createdAt DateTime @default(now()) //Data de criação
  updated DateTime @updatedAt // Atualiza automaticamente ao modificar o registro

  order_id String //chave estrangeira do pedido
  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade) //relação com pedido (se deletar o pedido, os itens também serão deletados)
  
  product_id String //chave estrangeira do pedido
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade) //relação com o produto (se deletar o produto, os itens também serão deletados)

  @@map("items") //nome da tabela no banco de dados
}




